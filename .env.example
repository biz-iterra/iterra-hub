# ============================================================
# NAS(Docker) 実行用の環境変数
#   docker-compose.yml と同じディレクトリに `.env` としてコピーして使う。
#   ローカル開発用は .env.local.example を参照（用途が異なる）。
#
# NOTE: NEXT_PUBLIC_* はここに書いても反映されない。
#   クライアントバンドルに焼き込まれる値のため、イメージのビルド引数として渡す。
#   （.github/workflows/docker-publish.yml の build-args を参照）
# ============================================================

# アプリの公開 URL（末尾スラッシュなし）。
#   Cloudflare Tunnel の内側では、リクエストから公開 URL を復元できない
#   （Next は Host ヘッダを信用せず、サーバーの HOSTNAME=0.0.0.0 で組み立てる）。
#   OAuth の redirect_uri のように外部へ渡す URL はこの値から作る。
#   **未設定だと Gmail 連携が Google に拒否される。**
APP_ORIGIN=https://hub.iterra.online

# Supabase のサービスロールキー（RLS をバイパスするため取り扱い注意）
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Zero Trust で発行した Tunnel トークン
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# Gmail 連携（未設定でも起動は通り、連携メニューが「未設定」表示になるだけ）
# ------------------------------------------------------------

# Google Cloud の OAuth 2.0 クライアント（ウェブアプリケーション）。
#   承認済みリダイレクト URI に https://hub.iterra.online/api/gmail/callback を登録する。
#   開発機とは別のクライアントを使う（本番の値を手元に持ってこない）。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# リフレッシュトークンを DB に保存する際の暗号鍵（pgcrypto の pgp_sym_encrypt）。
#   **変更・紛失すると保存済みトークンを復号できず、全員が再連携になる。**
GMAIL_TOKEN_ENCRYPTION_KEY=

# 定期同期エンドポイント（/api/gmail/sync）の合言葉。
#   タスクスケジューラから Bearer トークンとして送る（docs/deployment-nas.md § 8.0）。
#   **未設定ならエンドポイントは 503 を返し、定期同期が動かない。**
GMAIL_SYNC_CRON_SECRET=

# 事業者情報の実在確認（国税庁 法人番号 Web-API）のアプリケーション ID。
#   未設定でも起動は通り、実在確認が「未設定」表示になるだけ。
HOUJIN_BANGOU_APP_ID=

# Cloudflare Access の認証をアプリのログインに引き継ぐための設定。
#   両方そろって初めて有効になる。**未設定ならこれまでどおりログイン画面が出る**
#   （ローカル開発は未設定のままでよい）。
#   取得場所: Zero Trust → Access → Applications → 対象アプリ → Overview
#     CF_ACCESS_TEAM_DOMAIN … <team>.cloudflareaccess.com
#     CF_ACCESS_AUD         … Application Audience (AUD) Tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# 使用するイメージタグ。通常は未設定（latest）。
# 切り戻す場合のみ sha-<コミットSHA> を指定する。
# IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
