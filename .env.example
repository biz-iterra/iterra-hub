# ============================================================
# NAS(Docker) 実行用の環境変数
#   docker-compose.yml と同じディレクトリに `.env` としてコピーして使う。
#   ローカル開発用は .env.local.example を参照（用途が異なる）。
#
# NOTE: NEXT_PUBLIC_* はここに書いても反映されない。
#   クライアントバンドルに焼き込まれる値のため、イメージのビルド引数として渡す。
#   （.github/workflows/docker-publish.yml の build-args を参照）
# ============================================================

# アプリの公開 URL（末尾スラッシュなし）。
#   Cloudflare Tunnel の内側では、リクエストから公開 URL を復元できない
#   （Next は Host ヘッダを信用せず、サーバーの HOSTNAME=0.0.0.0 で組み立てる）。
#   OAuth の redirect_uri のように外部へ渡す URL はこの値から作る。
#   **未設定だと Gmail 連携が Google に拒否される。**
APP_ORIGIN=https://hub.iterra.online

# Supabase のサービスロールキー（RLS をバイパスするため取り扱い注意）
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Zero Trust で発行した Tunnel トークン
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------
# Gmail 連携（未設定でも起動は通り、連携メニューが「未設定」表示になるだけ）
# ------------------------------------------------------------

# Google Cloud の OAuth 2.0 クライアント（ウェブアプリケーション）。
#   承認済みリダイレクト URI に https://hub.iterra.online/api/gmail/callback を登録する。
#   開発機とは別のクライアントを使う（本番の値を手元に持ってこない）。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# リフレッシュトークンを DB に保存する際の暗号鍵（pgcrypto の pgp_sym_encrypt）。
#   **変更・紛失すると保存済みトークンを復号できず、全員が再連携になる。**
GMAIL_TOKEN_ENCRYPTION_KEY=

# 定期同期エンドポイント（/api/gmail/sync）の合言葉。
#   タスクスケジューラから Bearer トークンとして送る（docs/deployment-nas.md § 8.0）。
#   **未設定ならエンドポイントは 503 を返し、定期同期が動かない。**
GMAIL_SYNC_CRON_SECRET=

# 事業者情報の実在確認（国税庁 法人番号 Web-API）のアプリケーション ID。
#   未設定でも起動は通り、実在確認が「未設定」表示になるだけ。
HOUJIN_BANGOU_APP_ID=

# Cloudflare Access の認証をアプリのログインに引き継ぐための設定。
#   両方そろって初めて有効になる。**未設定ならこれまでどおりログイン画面が出る**
#   （ローカル開発は未設定のままでよい）。
#   取得場所: Zero Trust → Access → Applications → 対象アプリ → Overview
#     CF_ACCESS_TEAM_DOMAIN … <team>.cloudflareaccess.com
#     CF_ACCESS_AUD         … Application Audience (AUD) Tag
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# コーポレートサイトの問い合わせ取込（D1 corporate-iterra-leads）。
#   3 つそろって初めて有効になり、未設定なら /api/leads/inquiry-sync は 503 を返す。
#   API トークンは **corporate-iterra の本番アカウント API トークンと同じもの**を使う
#   （アカウント API トークンは環境ごとに 1 本にまとめる方針。個別に発行しない）。
#   ローテーション時は両方の転記先を差し替える（docs/secrets-management.md の同値グループ）。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# 取込エンドポイントの合言葉。未設定なら取込は無効。
INQUIRY_SYNC_CRON_SECRET=

# 取り込んだリードの担当者。未設定なら最初の管理者に付く。
INQUIRY_SYNC_OWNER_EMAIL=

# freee 会計連携（取引先の突合）。
#   下の 3 つがそろって初めて有効になり、未設定なら管理画面が「未設定」と表示するだけ。
#   freee 開発者コンソールでアプリを作成し、コールバック URI に
#   https://hub.iterra.online/api/freee/callback を登録する。
#   **自動では書き込まない。** 差分を人が確認して反映したときだけ freee 側を
#   更新する（取引先の更新・新規登録）。定期同期は取り込みのみ。
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_TOKEN_ENCRYPTION_KEY=

# 定期同期エンドポイント（/api/freee/sync）の合言葉。未設定なら同期は無効。
FREEE_SYNC_CRON_SECRET=

# Google コンタクト連携（連絡先を Google へ配る。Phase 1 は CRM → Google の一方向）。
#   下の 3 つがそろって初めて有効になり、未設定なら /profile に「未設定」と出るだけ。
#   **Gmail 連携と同じ GCP プロジェクト**に**別の OAuth クライアント**を作る
#   （使い回すと Gmail 再連携時に権限を引きずり、逸脱監査が成立しない）。
#   コールバック URI に
#   https://hub.iterra.online/api/google-contacts/callback を登録する。
#   同意画面には「連絡先の表示、編集、ダウンロード、完全な削除」と出る。
#   People API で書き込めるスコープはこれ 1 つだけで、絞り込みは用意されていない。
#   実際に触るのは「ITERRA CRM」グループの中だけだが、それはアプリ側の制約。
#   接続は利用者ごと（/profile から各自が行う）。
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_TOKEN_ENCRYPTION_KEY=

# 定期同期エンドポイント（/api/google-contacts/sync）の合言葉。未設定なら同期は無効。
GOOGLE_CONTACTS_SYNC_CRON_SECRET=

# 接続を許す Workspace のドメイン（秘密値ではない）。
# **未設定だと個人の Google アカウントでも繋がる**ため必ず設定する。
GOOGLE_CONTACTS_ALLOWED_DOMAIN=

# 使用するイメージタグ。通常は未設定（latest）。
# 切り戻す場合のみ sha-<コミットSHA> を指定する。
# IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
