# ============================================================
# NAS(Docker) 実行用の環境変数
#   docker-compose.yml と同じディレクトリに `.env` としてコピーして使う。
#   ローカル開発用は .env.local.example を参照（用途が異なる）。
#
# NOTE: NEXT_PUBLIC_* はここに書いても反映されない。
#   クライアントバンドルに焼き込まれる値のため、イメージのビルド引数として渡す。
#   （.github/workflows/docker-publish.yml の build-args を参照）
# ============================================================

# Supabase のサービスロールキー（RLS をバイパスするため取り扱い注意）
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Zero Trust で発行した Tunnel トークン
CLOUDFLARE_TUNNEL_TOKEN=

# 使用するイメージタグ。通常は未設定（latest）。
# 切り戻す場合のみ sha-<コミットSHA> を指定する。
# IMAGE_TAG=sha-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
