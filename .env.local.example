# ローカル開発用。`.env.local` にコピーして値を埋める。
# 値は `npx supabase start` / `npx supabase status` の出力から転記する。
#
# NOTE: DB 接続文字列（postgresql://...）はここに書かない。
#   アプリは Supabase API 経由で接続するため不要で、平文の DB パスワードを増やすだけになる。
#   接続文字列が必要なのは日次バックアップのみで、GitHub Secrets に登録する。

# supabase status の「API URL」
NEXT_PUBLIC_SUPABASE_URL=

# supabase status の「Publishable」（旧 anon key。sb_publishable_... 形式）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# supabase status の「Secret」（旧 service_role key。sb_secret_... 形式）
#   RLS をバイパスするため取り扱い注意。
#   未設定でも画面表示は動くが、createAdminClient() を使う以下が失敗する:
#     - リードのバルク更新（src/actions/leads.ts）
#     - スコア再計算（src/lib/leads/recalculate-score.ts）
SUPABASE_SERVICE_ROLE_KEY=

# 国税庁 法人番号システム Web-API のアプリケーションID（無償）
#   法人情報の実在確認（Admin → 法人情報 → 実在確認）で使う。
#   未設定でもビルド・起動は通り、実行時に「未設定」と表示されるだけ。
#   発行: https://www.houjin-bangou.nta.go.jp/webapi/ の利用申請から取得する
HOUJIN_BANGOU_APP_ID=

# ---- Gmail 連携（連絡先とのやり取りの同期）----
# Google Cloud の OAuth 2.0 クライアント（種類: ウェブアプリケーション）。
#   スコープは gmail.metadata のみ。本文・添付を取得できる権限は要求しない。
#   承認済みリダイレクト URI に以下を登録すること:
#     開発 http://localhost:2000/api/gmail/callback
#     本番 https://hub.iterra.online/api/gmail/callback
#   未設定でもビルド・起動は通り、連携メニューが「未設定」と表示されるだけ。
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# リフレッシュトークンを DB に保存する際の暗号鍵（pgcrypto の pgp_sym_encrypt）。
#   32 バイト以上のランダム文字列。DB のダンプだけが漏れても復号できないよう
#   鍵は DB に置かずここで持つ。
#   生成例（PowerShell / openssl は Windows に無いことがある）:
#     $b = [byte[]]::new(48)
#     [System.Security.Cryptography.RandomNumberGenerator]::Fill($b)
#     [Convert]::ToBase64String($b)
#   生成は必ず自分のターミナルで実行する（値をチャットやログに残さないため）
#   **変更すると既存の連携が全て復号できなくなる**（利用者に再連携を求めることになる）
GMAIL_TOKEN_ENCRYPTION_KEY=

# 定期同期エンドポイント（/api/gmail/sync）の合言葉。
#   NAS のタスクスケジューラから Bearer トークンとして送る。
#   **未設定ならエンドポイントは 503 を返して無効になる。**
#   開発機では設定不要（プロフィール画面の「同期」ボタンで足りる）。
#   生成は GMAIL_TOKEN_ENCRYPTION_KEY と同じ手順で、別の値にすること。
GMAIL_SYNC_CRON_SECRET=
