# local / ephemeral
# settings.json だけは共有する（.env の読み取り禁止など、環境によらず効かせたいルール）。
# ディレクトリごと除外すると中の否定パターンが効かないため .claude/* にしている
.claude/*
!.claude/settings.json
screenshots/
test_*.py
scripts/test-*.py

# 顧客データ（架電リスト等）— リポジトリに含めない
*.csv
!supabase/**/*.csv
