{
  // 綴りチェック（VS Code の Code Spell Checker 拡張が読む）。
  //
  // このプロジェクトは日本語のコメントと固有名詞が多く、既定の辞書では
  // 正しい語が大量に警告される（freee / Bitwarden / pgcrypto など）。
  // **警告が常時出ていると本物の誤字を見落とす**ので、正しい語はここへ登録する。
  //
  // 語を足すときは下のカテゴリに沿って**アルファベット順**で入れること。
  // 判定は大文字小文字を区別しないため、freee / Freee / FREEE は 1 つでよい。
  //
  // **CI のゲートには入れない**（2026-08-05 の判断）。固有名詞を足すたびに
  // ビルドが落ちる方が煩わしく、綴りは誤字に気づくための補助として扱う。
  // 手元で全体を見るときは:
  //   npx cspell "src/**/*.{ts,tsx}" "docs/**/*.md" "supabase/migrations/*.sql"
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules/**",
    ".next/**",
    "package-lock.json",
    "src/types/database.generated.ts",
    // Supabase CLI が作る作業ファイル（プロジェクト ID などが入る）
    "supabase/.temp/**",
    "e2e/.auth/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "ignoreRegExpList": [
    // 全角英字の連続。半角へ寄せる変換表（20260802000003 ほか）で使う
    "[\\uFF21-\\uFF3A\\uFF41-\\uFF5A]{4,}",
    // URL エンコード（?sort=name%3Aasc の %3A が語に混ざる）
    "%[0-9A-Fa-f]{2}"
  ],
  "words": [
    // ---- 製品・サービス名 ----
    "bitwarden",
    "chatwork",
    "cloudflared",
    "freee",
    "inbucket",
    "ipadic",
    "kuromoji",
    "mailpit",
    "peatix",
    "postgrest",
    "sansan",
    "supabase",
    "turbopack",
    "ugos",
    "ugreen",

    // ---- 自社・プロジェクト固有 ----
    "appo", // tele_appo（テレアポ）のスラッグ
    "bangou", // HOUJIN_BANGOU_APP_ID（法人番号 Web-API）
    "cntr", // 契約コードの接頭辞
    "houjin",
    "iterra",
    "leadstage",
    "sumi", // 配色トークン（墨）
    "tele", // tele_appo / teleappointment
    "teleappointment",
    "tlnt", // タレントコードの接頭辞

    // ---- PostgreSQL / SQL ----
    "alnum",
