{
  "name": "iterra-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 2000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @sweep",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "db:er": "node scripts/generate-er-diagram.mjs",
    "test:sweep": "playwright test e2e/zz-sweep.e2e.ts",
    "test:db": "node scripts/test-db/run.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@types/kuromoji": "^0.1.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.7",
    "kuromoji": "^0.1.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "//@emnapi": [
    "直接は使わない。wasm32-wasi 版のネイティブ binding（vitest / sharp / unrs-resolver）が",
    "要求するが、lock を作った環境で対象外になるため npm がトップレベルに書かず、",
    "CI（linux/x64）の npm ci が EUSAGE で落ちていた。明示依存にして必ず載るようにする。",
    "外すときは npm ci を linux でも通してから"
  ],
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
